{
  "name": "fable",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "node scripts/patch-kysely.cjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate --filter=@fable/db",
    "db:push": "turbo db:push --filter=@fable/db",
    "db:migrate": "turbo db:migrate --filter=@fable/db",
    "db:studio": "turbo db:studio --filter=@fable/db",
    "lingui:extract": "turbo lingui:extract --filter=@fable/web",
    "lingui:compile": "turbo lingui:compile --filter=@fable/web",
    "lingui:extract:watch": "turbo lingui:extract:watch --filter=@fable/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
