# Database (Supabase / Postgres)
DATABASE_URL= # Postgres connection string used by the app at runtime (pooled URL on Supabase)
DIRECT_URL= # Postgres connection string for migrations and db:push (direct/non-pooled URL on Supabase; same as DATABASE_URL on Railway)

# Auth
BETTER_AUTH_SECRET= # Secret for signing Better Auth sessions; use a long random string
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Public base URL of the web app (auth callbacks, Stripe redirects)
TRUSTED_ORIGINS=http://localhost:3000 # Comma-separated allowed origins for Better Auth CORS

# OpenAI (optional; machine translation is disabled if unset)
OPENAI_API_KEY= # OpenAI API key for AI-powered machine translation

# Redis (BullMQ worker queues: MT translate, QA, VCS sync, webhooks)
REDIS_URL=redis://localhost:6379 # Redis connection URL

# GitHub App (optional; GitHub/VCS integration is disabled if unset)
# Create at https://github.com/settings/apps/new
# Permissions: Contents (read/write), Pull requests (write), Metadata (read)
# Webhook URL: https://yourdomain.com/api/webhooks/github
GITHUB_APP_ID= # Numeric ID of your GitHub App
GITHUB_PRIVATE_KEY= # PEM private key for the GitHub App (escape newlines as \n)
GITHUB_WEBHOOK_SECRET= # Webhook secret from your GitHub App settings
NEXT_PUBLIC_GITHUB_APP_SLUG= # URL slug of your GitHub App (used in install links)

# Stripe (optional; billing and paid plans are disabled if unset)
# Use `stripe listen --forward-to localhost:3000/api/stripe/webhook` for local webhook testing
STRIPE_SECRET_KEY= # Stripe secret API key from the Stripe dashboard
STRIPE_WEBHOOK_SECRET= # Signing secret for the /api/stripe/webhook endpoint
STRIPE_PRO_MONTHLY_PRICE_ID= # Price ID for Fable Pro monthly subscription ($29)
STRIPE_PRO_ANNUAL_PRICE_ID= # Price ID for Fable Pro annual subscription ($313.20)
STRIPE_MT_METERED_PRICE_ID= # Price ID for metered MT character usage billing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # Stripe publishable key (client-side; optional)
