# Database (Supabase / Postgres)
DATABASE_URL=
DIRECT_URL=

# Auth
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# AI (Anthropic)
OPENAI_API_KEY=

# Redis (for BullMQ worker)
REDIS_URL=redis://localhost:6379

# GitHub App (for VCS source sync)
# Create a GitHub App at https://github.com/settings/apps/new
# Required permissions: Contents (read/write), Pull requests (write), Metadata (read)
# Webhook URL: https://yourdomain.com/api/webhooks/github
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=

# Stripe
# Create products/prices in the Stripe dashboard, then paste the IDs here.
# Use `stripe listen --forward-to localhost:3000/api/stripe/webhook` for local webhook testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_MT_METERED_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
